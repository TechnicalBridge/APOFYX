# =============================================================================
#  APOFYX — configuracion local
# =============================================================================
#  Copiar este archivo como .env y ajustar lo que haga falta:
#      copy .env.example .env          (Windows)
#      cp   .env.example .env          (bash)
#
#  .env NO se sube al repositorio: esta en .gitignore.
#  docker-compose.yml lee estas variables automaticamente.
# =============================================================================

# --- Base de datos ---------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=apofyx
MYSQL_USER=apofyx_app
MYSQL_PASSWORD=apofyx_pass

# Puerto del HOST donde se publica la base. Se usa 3307 y no 3306 para no
# chocar con el MySQL 8.4 instalado en el equipo.
MYSQL_PORT=3307

# --- Django ----------------------------------------------------------------
# Para desarrollo sirve cualquier cadena. Generar una real con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-inseguro-cambiar
DJANGO_DEBUG=1
WEB_PORT=8000

# Al correr Django FUERA de Docker, la base esta en 127.0.0.1:3307.
# Dentro de Docker, compose sobreescribe esto con db:3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=apofyx
DB_USER=apofyx_app
DB_PASSWORD=apofyx_pass

# --- Asistente -------------------------------------------------------------
# Clave del tier gratuito de Google AI Studio. Solo se usa como respaldo,
# cuando el motor de reglas no alcanza el umbral de confianza.
# Si se deja vacia, el asistente responde igual: solo por reglas.
# Modelo: se usa un "lite" porque no razona. Los flash recientes gastan el
# presupuesto de salida pensando y devuelven frases cortadas.
GEMINI_MODEL=gemini-3.1-flash-lite
# La API rechaza tiempos de espera menores a 10000 ms.
GEMINI_TIMEOUT_MS=12000
GEMINI_API_KEY=

# --- Usuario administrador -------------------------------------------------
# Lo usa "manage.py createsuperuser --noinput" para crear el acceso al panel
# y al admin de Django, sin escribir credenciales en el codigo.
# CAMBIAR la contrasena antes de mostrar esto a alguien.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@apofyx.cl
DJANGO_SUPERUSER_PASSWORD=apofyx2026
